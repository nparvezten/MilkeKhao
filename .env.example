# MilkeKhao Enterprise Multi-Tenant Platform Environment Variables Configuration
# Copy to .env for local docker deployment. DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT!

# Database Configuration
POSTGRES_DB=milkekhaodb
POSTGRES_USER=milkekhao_user
POSTGRES_PASSWORD=enterprise_secure_password_2026!
CONNECTION_STRING=Host=postgres;Port=5432;Database=milkekhaodb;Username=milkekhao_user;Password=enterprise_secure_password_2026!

# JWT Security Credentials
JWT_SECRET_KEY=MilkeKhao_Super_Secret_Enterprise_JWT_Key_2026_Must_Be_At_Least_256_Bits!
JWT_ISSUER=MilkeKhaoAPI
JWT_AUDIENCE=MilkeKhaoClients
JWT_EXPIRY_MINUTES=15

# Payment Provider Configuration (Per-Tenant Keys encrypted in DB)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
PAYU_MERCHANT_KEY=payu_test_placeholder_key
PAYU_MERCHANT_SALT=payu_test_placeholder_salt

# Notifications & SMTP Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.placeholder_api_key
SMS_PROVIDER_API_KEY=sms_provider_secret_token
